<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>AskInky</RootNamespace>
    <StartupObject>AskInky.Program</StartupObject>
    <OptionStrict>On</OptionStrict>
    <OptionExplicit>On</OptionExplicit>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>Assets\RedInk.ico</ApplicationIcon>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>embedded</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <PackageReference Include="Markdig" Version="0.41.3" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="LICENSE.txt" LogicalName="AskInky.LICENSE.txt" />
    <EmbeddedResource Include="Assets\Red_Ink_Logo.png" LogicalName="AskInky.Assets.Red_Ink_Logo.png" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Web\I18n\de.json" LogicalName="AskInky.Web.I18n.de.json" WithCulture="false" />
    <EmbeddedResource Include="Web\I18n\en.json" LogicalName="AskInky.Web.I18n.en.json" WithCulture="false" />
    <EmbeddedResource Include="Web\I18n\fr.json" LogicalName="AskInky.Web.I18n.fr.json" WithCulture="false" />
    <EmbeddedResource Include="Web\I18n\it.json" LogicalName="AskInky.Web.I18n.it.json" WithCulture="false" />
    <EmbeddedResource Include="Web\assistant.html" LogicalName="AskInky.Web.assistant.html" WithCulture="false" />
    <EmbeddedResource Include="Web\assistant.js" LogicalName="AskInky.Web.assistant.js" WithCulture="false" />
    <EmbeddedResource Include="Web\common.js" LogicalName="AskInky.Web.common.js" WithCulture="false" />
    <EmbeddedResource Include="Web\desktop.css" LogicalName="AskInky.Web.desktop.css" WithCulture="false" />
    <EmbeddedResource Include="Web\office-web.css" LogicalName="AskInky.Web.office-web.css" WithCulture="false" />
    <EmbeddedResource Include="Web\rendering.js" LogicalName="AskInky.Web.rendering.js" WithCulture="false" />
    <EmbeddedResource Include="Web\settings.html" LogicalName="AskInky.Web.settings.html" WithCulture="false" />
    <EmbeddedResource Include="Web\settings.js" LogicalName="AskInky.Web.settings.js" WithCulture="false" />
  </ItemGroup>
    <!-- Authenticode signing of the published portable EXE -->
    <PropertyGroup>
        <AskInkySignTool>C:\Program Files (x86)\Windows Kits\10\bin\10.0.26100.0\x64\signtool.exe</AskInkySignTool>
        <AskInkyCertificateThumbprint>1EF41035D3AC9F8A9A678B845DA2F69C765D00E0</AskInkyCertificateThumbprint>
    </PropertyGroup>

    <Target Name="SignAskInky"
            AfterTargets="Publish"
            Condition="'$(Configuration)' == 'Release' and '$(PublishSingleFile)' == 'true' and '$(RuntimeIdentifier)' == 'win-x64'">

        <PropertyGroup>
            <AskInkyPublishedExe>$(PublishDir)AskInky.exe</AskInkyPublishedExe>
        </PropertyGroup>

        <Error Condition="!Exists('$(AskInkySignTool)')"
               Text="Ask Inky: SignTool.exe not found." />

        <Error Condition="!Exists('$(AskInkyPublishedExe)')"
               Text="Ask Inky: Published EXE not found." />

        <Exec Command="&quot;$(AskInkySignTool)&quot; sign /sha1 $(AskInkyCertificateThumbprint) /fd SHA256 /tr http://timestamp.digicert.com /td SHA256 /d &quot;Ask Inky&quot; /du &quot;https://redink.ai&quot; &quot;$(AskInkyPublishedExe)&quot;" />

        <Exec Command="&quot;$(AskInkySignTool)&quot; verify /pa /tw /v &quot;$(AskInkyPublishedExe)&quot;" />

        <Message Importance="high"
                 Text="Ask Inky: Authenticode signature verified successfully." />

    </Target>
</Project>
