<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- P18 W367: UI Automation (System.Windows.Automation) for selection capture. -->
    <UseWPF>true</UseWPF>
    <Version>2.0.4</Version>
    <FileVersion>2.0.4.0</FileVersion>
    <Company>LawDigital AG</Company>
    <Product>Ask Inky (Red Ink)</Product>
    <Copyright>Copyright (c) LawDigital AG, Switzerland</Copyright>
    <RootNamespace>AskInky</RootNamespace>
    <StartupObject>AskInky.Program</StartupObject>
    <OptionStrict>On</OptionStrict>
    <OptionExplicit>On</OptionExplicit>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>Assets\RedInk.ico</ApplicationIcon>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>embedded</DebugType>
    <!-- W382: build scripts, installer source and build outputs live in this folder; never compiled or published. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);dist\**;.tools\**;.wix\**;build\**;Setup\**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="AskInky.SelfTest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <PackageReference Include="Markdig" Version="0.41.3" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="LICENSE.txt" LogicalName="AskInky.LICENSE.txt" />
    <EmbeddedResource Include="Assets\Red_Ink_Logo.png" LogicalName="AskInky.Assets.Red_Ink_Logo.png" />
    <EmbeddedResource Include="Assets\Red_Ink_Logo_Large.png" LogicalName="AskInky.Assets.Red_Ink_Logo_Large.png" />
    <EmbeddedResource Include="Web\redink-logo.png" LogicalName="AskInky.Web.redink-logo.png" WithCulture="false" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Web\I18n\de.json" LogicalName="AskInky.Web.I18n.de.json" WithCulture="false" />
    <EmbeddedResource Include="Web\I18n\en.json" LogicalName="AskInky.Web.I18n.en.json" WithCulture="false" />
    <EmbeddedResource Include="Web\I18n\fr.json" LogicalName="AskInky.Web.I18n.fr.json" WithCulture="false" />
    <EmbeddedResource Include="Web\I18n\it.json" LogicalName="AskInky.Web.I18n.it.json" WithCulture="false" />
    <EmbeddedResource Include="Web\assistant.html" LogicalName="AskInky.Web.assistant.html" WithCulture="false" />
    <EmbeddedResource Include="Web\assistant.js" LogicalName="AskInky.Web.assistant.js" WithCulture="false" />
    <EmbeddedResource Include="Web\common.js" LogicalName="AskInky.Web.common.js" WithCulture="false" />
    <EmbeddedResource Include="Web\desktop.css" LogicalName="AskInky.Web.desktop.css" WithCulture="false" />
    <EmbeddedResource Include="Web\office-web.css" LogicalName="AskInky.Web.office-web.css" WithCulture="false" />
    <EmbeddedResource Include="Web\rendering.js" LogicalName="AskInky.Web.rendering.js" WithCulture="false" />
    <EmbeddedResource Include="Web\settings.html" LogicalName="AskInky.Web.settings.html" WithCulture="false" />
    <EmbeddedResource Include="Web\settings.js" LogicalName="AskInky.Web.settings.js" WithCulture="false" />
  </ItemGroup>
    <!-- P18 W367: no certificate thumbprint in the project. Signing is done after publish by
         build\sign-askinky.ps1 (or Alles-signieren on the release mirror), which selects the
         VISCHER AG code-signing certificate automatically. Unsigned builds are TEST builds. -->
</Project>