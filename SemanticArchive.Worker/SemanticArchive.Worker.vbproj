    <ProjectReference Include="..\SharedLibrary\SharedLibrary.vbproj">
      <Project>{26AD9D75-3B7F-4E7E-AFBD-108D2D343538}</Project>
      <Name>SharedLibrary</Name>
    </ProjectReference>
    <Compile Include="AssemblyInfo.vb" />
    <Compile Include="Program.vb" />
    <Compile Include="WorkerOptions.vb" />
    <Compile Include="WorkerDrainPolicy.vb" />
    <None Include="README.md" />
    <None Include="WORKER_HELP.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="App.config" />
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.VisualBasic.targets" />
  <!-- System.ValueTuple is inbox on net48. Match the net471+ package target:
       do not generate a redirect to the net462 package implementation (4.0.5.0). -->
  <Target Name="KeepWorkerFrameworkValueTupleBinding" DependsOnTargets="ResolveAssemblyReferences" BeforeTargets="GenerateBindingRedirects" Condition="'$(TargetFrameworkVersion)' == 'v4.8'">
    <ItemGroup>
      <SuggestedBindingRedirects Remove="System.ValueTuple, Culture=neutral, PublicKeyToken=cc7b13ffcd2ddd51" />
    </ItemGroup>
  </Target>
  <Target Name="ValidateWorkerRuntimeReferencePaths" BeforeTargets="ResolveAssemblyReferences" Condition="'$(DesignTimeBuild)' != 'true'">
    <Error Condition="'%(Reference.HintPath)' != '' And !Exists('%(Reference.HintPath)')"
           Text="Worker runtime reference is missing: %(Reference.HintPath). Restore the solution NuGet packages before building." />
  </Target>
</Project>
